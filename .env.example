# Copy this file to .env.local and fill in your Supabase project values
# Find these in: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google OAuth Web client ID (Google Cloud → Credentials → OAuth client ID).
# Used by Google Identity Services so the consent screen shows YOUR domain.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
